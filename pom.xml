    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.0.0-M7</version>
                    <configuration>
                        <systemPropertyVariables>
                            <platform>${platform}</platform>
                            <threads>${threads}</threads>
                            <sessions>${sessions}</sessions>
                            <testdata>${testdata}</testdata>
                            <module>${module}</module>
                            <testtype>${testtype}</testtype>
                            <env>${env}</env>
                            <buildtype>${buildtype}</buildtype>
                        </systemPropertyVariables>
                        <argLine>-javaagent:"${com.browserstack:browserstack-java-sdk:jar}" -Djdk.net.usePlainDatagramSocketImpl=true</argLine>
                        <parallel>methods</parallel>
                        <threadCount>${threads}</threadCount>
                        <properties>
                            <property>
                                <name>listener</name>
                                <value>com.tiket.testng.AnnotationTransformer,
                                    com.tiket.testng.TestListener</value>
                            </property>
                        </properties>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>getClasspathFilenames</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                  <annotationProcessorPaths>
                    <path>
                      <groupId>org.projectlombok</groupId>
                      <artifactId>lombok</artifactId>
                      <version>1.18.38</version>
                    </path>
                  </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>com.tiket.tools.caselookup.CaseRunLookup</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>